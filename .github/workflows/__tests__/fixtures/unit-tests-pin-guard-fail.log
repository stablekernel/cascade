2026-07-05T01:36:31.2774233Z             # Update environment-level state (committed, not deployed)
2026-07-05T01:36:31.2774959Z             yq eval -i ".$MANIFEST_KEY.state.$ENVIRONMENT.sha = \"$HEAD_SHA\"" "$MANIFEST_FILE"
2026-07-05T01:36:31.2775754Z             yq eval -i ".$MANIFEST_KEY.state.$ENVIRONMENT.version = \"$VERSION\"" "$MANIFEST_FILE"
2026-07-05T01:36:31.2776850Z             yq eval -i ".$MANIFEST_KEY.state.$ENVIRONMENT.committed_at = \"$TIMESTAMP\"" "$MANIFEST_FILE"
2026-07-05T01:36:31.2777773Z             yq eval -i ".$MANIFEST_KEY.state.$ENVIRONMENT.committed_by = \"${{ github.actor }}\"" "$MANIFEST_FILE"
