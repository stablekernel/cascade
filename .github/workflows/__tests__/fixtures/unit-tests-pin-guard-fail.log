2026-07-05T01:36:31.2786077Z                 exit 0
2026-07-05T01:36:31.2786317Z               fi
2026-07-05T01:36:31.2786931Z               echo "Push attempt $attempt rejected (likely concurrent run); retrying..." >&2
2026-07-05T01:36:31.2787445Z               sleep $((RANDOM % 5 + 2))
