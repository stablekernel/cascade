2026-07-05T01:36:31.2789514Z           # Real GitHub: write state through the Contents REST API. API commits are
2026-07-05T01:36:31.2790350Z           # signed by GitHub (Verified) and, with a bypass-capable token, update the
2026-07-05T01:36:31.2790929Z           # trunk even when a required status check protects it.
2026-07-05T01:36:31.2791346Z           for attempt in 1 2 3 4 5; do
2026-07-05T01:36:31.2791868Z             git fetch origin "$BRANCH"
2026-07-05T01:36:31.2792243Z             git reset --hard "origin/$BRANCH"
2026-07-05T01:36:31.2792595Z             apply_state_edits
2026-07-05T01:36:31.2792995Z             if git diff --quiet "$MANIFEST_FILE"; then
