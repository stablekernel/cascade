2026-07-05T01:36:31.2793681Z               exit 0
2026-07-05T01:36:31.2793912Z             fi
2026-07-05T01:36:31.2794561Z             CONTENT_B64=$(base64 -w0 "$MANIFEST_FILE" 2>/dev/null || base64 "$MANIFEST_FILE" | tr -d '\n')
2026-07-05T01:36:31.2795629Z             CURRENT_SHA=$(gh api "repos/${{ github.repository }}/contents/$MANIFEST_FILE?ref=$BRANCH" --jq '.sha' 2>/dev/null || true)
2026-07-05T01:36:31.2796481Z             API_ARGS=("repos/${{ github.repository }}/contents/$MANIFEST_FILE" -X PUT
2026-07-05T01:36:31.2797147Z               -f "message=chore: update state for $ENVIRONMENT [skip ci]"
2026-07-05T01:36:31.2797621Z               -f "content=$CONTENT_B64"
2026-07-05T01:36:31.2797975Z               -f "branch=$BRANCH"
